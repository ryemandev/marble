# Copy to app/.env and fill in your own values. These are read by the browser app (Vite),
# so only put public values here: never a service role key or any other secret.

# Your Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Where the app is served from
VITE_APP_URL=http://localhost:5173

# Optional: Google sign-in (Google Cloud console -> OAuth client ID)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_ORIGINS=

# Optional: web push. Run `node scripts/vapid-keys.mjs` to generate a pair; only the public key goes here.
VITE_VAPID_PUBLIC_KEY=
