# Server secrets for the Supabase Edge Functions. Never commit real values.
# Set them with `supabase secrets set --env-file supabase/functions/.env` or in
# Supabase -> Edge Functions -> Secrets. SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Origins allowed to call the functions (comma separated)
MARBLE_ORIGINS=http://localhost:5173,https://your-domain.example

# Email (Resend)
RESEND_API_KEY=
# Signs unsubscribe links: any long random string
EMAIL_LINK_SECRET=

# Forms and anti-spam (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=
# Salt for hashing IPs on forms and CSP reports: any long random string
FORMS_HASH_SALT=

# Web push (node scripts/vapid-keys.mjs)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Voice rooms (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# News dashboard
MEDIASTACK_KEY=
BLS_API_KEY=
BEA_API_KEY=
DATA_CONTACT_EMAIL=support@example.com

# Scheduled jobs read their shared secrets from Supabase Vault, not from here. Create these
# Vault secrets (each a random 64-character string): trial_emails_cron, news_sync_cron,
# dm_alerts_cron, push_cron, crash_digest_cron, owner_alerts_cron, welcome_email_cron
